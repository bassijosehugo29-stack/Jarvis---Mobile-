#!/bin/sh
# Source-only checkout bootstrap: install the official wrapper after checksum validation.
# Once generated by `gradle wrapper`, Gradle replaces this script with its standard launcher.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
    "$APP_HOME/scripts/bootstrap-wrapper.sh"
fi
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD=java
fi
exec "$JAVA_CMD" -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
